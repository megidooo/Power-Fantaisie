float PI2 = 6.28318530718;
float EPSILON = 1e-7; 


float Pique(float x,float decalage,float etendue, float piquantisme){
	return 1.0 / (1.0 + piquantisme * pow((x - decalage) / etendue, 2.0));
}
vec3 grad( ivec3 z ){
	// 3D to 1D
	int n = z.x + z.y*11111 + z.z*333667;

	// Hugo Elias hash
	n = (n<<13)^n;
	n = (n*(n*n*15731+789221)+1376312589)>>16;
	// Perlin-style: the 12 midpoints of a cubes edges
	// (1,1, 0), (1, 0,1), ( 0,1,1)
	n &= 11;  // 12 gradients, wrap at 12 (use 11 as mask then clamp last)
	if (n > 11) n -= 12;

	const vec3 grads[12] = vec3[12](
		vec3( 1.0,  1.0,  0.0),
		vec3(-1.0,  1.0,  0.0),
		vec3( 1.0, -1.0,  0.0),
		vec3(-1.0, -1.0,  0.0),
		vec3( 1.0,  0.0,  1.0),
		vec3(-1.0,  0.0,  1.0),
		vec3( 1.0,  0.0, -1.0),
		vec3(-1.0,  0.0, -1.0),
		vec3( 0.0,  1.0,  1.0),
		vec3( 0.0, -1.0,  1.0),
		vec3( 0.0,  1.0, -1.0),
		vec3( 0.0, -1.0, -1.0)
	);
	return grads[n];
	
}
vec3 N33(vec3 p) {
	vec4 a = fract(p.xyzx * vec4(123.34, 232.45, 35.65, 154.78));
	a += dot(a, a + 34.34);
	return fract(vec3(a.x*a.y - 0.7, a.y*a.z + 0.1, a.z*a.w - 0.4));
}
float N31(vec3 p) { 
	p = fract(p * vec3(123.34, 456.78, 789.12));
	p += dot(p, p.yzx + 34.56);
	return fract((p.x + p.y) * p.z);
}
float map(float value, float min1, float max1, float min2, float max2) {
  return min2 + (value - min1) * (max2 - min2) / (max1 - min1);
}

vec4 Voronoi(vec3 p){
		
	vec3 gv = fract(p)-.5;
	vec3 id = floor(p);
	float minDist=1000.;
	float cId = 0.;
	vec3 nearestPoint;
	
	for (float z = -1.; z <= 1.; z++){
		for(float y =-1.; y<=1.;y++){
			for(float x = -1.; x<=1.;x++){
				vec3 offs = vec3(x,y,z);
				vec3 n = N33(offs+id);
				vec3 pos = offs+n+id;
				float d = length(p-pos);
			   
				if(d<minDist){
				minDist = d;
				cId = N31(offs+id); 
				nearestPoint = pos;
				}
			}
		}
	}
	
	vec3 n = normalize(p-nearestPoint);
	
	return vec4(minDist,n);
}
mat3 randomRotation(float seed) {
	vec2 r1 = normalize(vec2(
		fract(seed * 127.1 + 311.7) * 2.0 - 1.0,
		fract(seed * 269.5 + 183.3) * 2.0 - 1.0
	));
	vec2 r2 = normalize(vec2(
		fract(seed * 419.2 + 933.1) * 2.0 - 1.0,
		fract(seed * 371.9 + 246.1) * 2.0 - 1.0
	));

	mat3 m1 = mat3(
		vec3( r1.x, r1.y, 0.0),
		vec3(-r1.y, r1.x, 0.0),
		vec3(  0.0,  0.0, 1.0)
	);
	mat3 m2 = mat3(
		vec3( r2.x, 0.0, r2.y),
		vec3(  0.0, 1.0,  0.0),
		vec3(-r2.y, 0.0, r2.x)
	);

	return m2 * m1;
}
float fbm( vec3 p)
{    
	//Modifiables
	float H = 0.5;
	float fac= 2.;
	
	float G = exp2(-H);
	float f = 1.0;
	float a = 1.0;
	float t = 0.0;
	for( int i=0; i<3; i++ )
	{
		p*=randomRotation(float(i));
		t += a*Voronoi(p*f).x;
		f *= fac; 
		a *= G;
	}
	return t;
}
float PerlinNoise(vec3 pos){
	
	ivec3 flpos = ivec3(floor(pos*10.));
	vec3 frpos = fract(pos*10.);
	vec3 sfrpos = frpos*frpos*(3.-2.0*frpos);
		
	float BLD = dot(grad(flpos),frpos);;
	float TLD = dot(grad(flpos+ivec3(0,1,0)),frpos-vec3(0.,1.,0.));
	float TRD = dot(grad(flpos+ivec3(1,1,0)),frpos-vec3(1.,1.,0.));
	float BRD = dot(grad(flpos+ivec3(1,0,0)),frpos-vec3(1.,0.,0.));
   
	
	float BLU = dot(grad(flpos+ivec3(0,0,1)),frpos-vec3(0.,0.,1.));;
	float TLU = dot(grad(flpos+ivec3(0,1,1)),frpos-vec3(0.,1.,1.));
	float TRU = dot(grad(flpos+ivec3(1,1,1)),frpos-vec3(1.,1.,1.));
	float BRU = dot(grad(flpos+ivec3(1,0,1)),frpos-vec3(1.,0.,1.));
	
	
	
	float LD = mix(BLD,TLD,sfrpos.y);
	float RD = mix(BRD,TRD,sfrpos.y);
	
	float LU = mix(BLU,TLU,sfrpos.y);
	float RU = mix(BRU,TRU,sfrpos.y);
	
	
	float D = mix(LD,RD,sfrpos.x);
	float U = mix(LU,RU,sfrpos.x);
	
	float perlin = mix(D,U,sfrpos.z);
	
	
	return (perlin+1.)/2.;}

vec4 PerlinNoiseGradient(vec3 pos,float scale){
	
	ivec3 flpos = ivec3(floor(pos*scale));
	vec3 frpos = fract(pos*scale);
	vec3 s = frpos*frpos*(3.-2.0*frpos);
	
	vec3 g000 =grad(flpos);
	vec3 g010 =grad(flpos+ivec3(0,1,0));
	vec3 g110 =grad(flpos+ivec3(1,1,0));
	vec3 g100 =grad(flpos+ivec3(1,0,0));
	vec3 g001 =grad(flpos+ivec3(0,0,1));
	vec3 g011 =grad(flpos+ivec3(0,1,1));
	vec3 g111 =grad(flpos+ivec3(1,1,1));
	vec3 g101 =grad(flpos+ivec3(1,0,1));
	
	
	float c000 = dot(g000,frpos);;
	float c010 = dot(g010,frpos-vec3(0.,1.,0.));
	float c110 = dot(g110,frpos-vec3(1.,1.,0.));
	float c100 = dot(g100,frpos-vec3(1.,0.,0.));
   
	
	float c001 = dot(g001,frpos-vec3(0.,0.,1.));;
	float c011 = dot(g011,frpos-vec3(0.,1.,1.));
	float c111 = dot(g111,frpos-vec3(1.,1.,1.));
	float c101 = dot(g101,frpos-vec3(1.,0.,1.));
	
	
	
	float c0y0 = mix(c000,c010,s.y);
	float c1y0 = mix(c100,c110,s.y);
	
	float c0y1 = mix(c001,c011,s.y);
	float c1y1 = mix(c101,c111,s.y);
	
	
	float cxy0 = mix(c0y0,c1y0,s.x);
	float cxy1 = mix(c0y1,c1y1,s.x);
	
	float perlin = mix(cxy0,cxy1,s.z);
	
	
	vec3 w000 = (1.-s.x)*(1.-s.y)*(1.-s.z)*g000;
	vec3 w010 = (1.-s.x)*s.y*(1.-s.z)*g010;
	vec3 w110 = s.x*s.y*(1.-s.z)*g110;
	vec3 w100 = s.x*(1.-s.y)*(1.-s.z)*g100;
	vec3 w001 = (1.-s.x)*(1.-s.y)*s.z*g001;
	vec3 w011 = (1.-s.x)*s.y*s.z*g011;
	vec3 w111 = s.x*s.y*s.z*g111;
	vec3 w101 = s.x*(1.-s.y)*s.z*g101;
	
	vec3 smoothstepDerivative = 6.*frpos-6.*frpos*frpos;
	
	float ddx = (mix(c1y0,c1y1,s.z)-mix(c0y0,c0y1,s.z));
	
	float ddy = mix(mix( c010 ,c110,s.x),mix(c011,c111,s.x),s.z)-mix(mix(c000,c100,s.x),mix(c001,c101,s.x),s.z);
	
	float ddz = cxy1-cxy0;
	
	vec3 d = smoothstepDerivative*vec3(ddx,ddy,ddz)+w000+w001+w010+w011+w100+w101+w110+w111;
	
	return vec4((perlin+1.)/2.,d);

}

float BeerLambert(float t){

	return exp(-t);}
vec3 BeerLambert(vec3 t){

	return exp(-t);}

float opSmoothUnion( float a, float b, float k )
{
	k *= 4.0;
	float h = max(k-abs(a-b),0.0);
	return min(a, b) - h*h*0.25/k;
}






float map(vec3 p)
{
	
	float cam_length = length(p-CAMERA_POSITION_WORLD.xyz);
	float sphere = smoothstep(0.,1.,cam_length);
	
	float cell = N31(floor(p.xyy));
	
	float cercle = length(fract(p)-vec3(0.5))-0.3*sphere;
	
	p.x += cos(p.z)*cell*0.5;
	p.y +=sin(p.z)*cell*0.5;
	
	p.xy = fract(p.xy)-0.5;
	
	float tube = length(p.xy)-0.1;
	
	
	return cercle;  
}

float trace( vec3 ro, vec3 rd){
	vec3 p = ro;
	float dis =0.;
	
	for (int i = 0; i<128; i++){
		float d = map(p);
		dis+=d;
		if(d<0.001){
			return(dis);
		}
		p+=rd*d;
	}
	return -1.;
}

vec3 get_normal(vec3 p){
	vec2 e = vec2(0.01,0.);
	return normalize(vec3(map(p).x)-vec3(
	map(p-e.xyy).x,
	map(p-e.yxy).x,
	map(p-e.yyx).x
	));
	
}


[numthreads(8, 8, 1)]
void RayMarching() {

	
	
	ivec2 uv = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = ivec2(raster_size);
	
	vec2 nuv = vec2(uv)/vec2(size);
	
	if (uv.x >= size.x || uv.y >= size.y) return; 
	
	vec3 current = imageLoad(_RenderTarget, uv).rgb;
	
	
	
	
	
	vec3 ndc = vec3(nuv * 2.0 - 1.0, 1.0);
	vec4 view_dir4d = INV_PROJECTION_MATRIX * vec4(ndc, 1.0);
	vec3 view_dir = view_dir4d.xyz / view_dir4d.w;
	
	vec3 ro = CAMERA_POSITION_WORLD.xyz;
	vec3 rd = normalize(mat3(INV_VIEW_MATRIX) * view_dir);
		
	vec3 background = current;
	vec4 col = vec4(current,1.);
	

	
	float d = trace(ro,rd);

	if(d > 0.){
		vec3 n = get_normal(d*rd+ro);
		
		
		n = normalize(n);
		
		float fres = ((dot(n,rd)/2.+0.5));
		 
		vec3 lamb = dot(n,normalize(vec3(0.,1.,1.)))*_SurfaceCouleur;
		
		vec3 p = d*rd+ro; 
		
		
		
		
		 
		col =vec4(n,1.);  
		
		
	}
	
	
	imageStore(_RenderTarget, uv, col); 
	

}
